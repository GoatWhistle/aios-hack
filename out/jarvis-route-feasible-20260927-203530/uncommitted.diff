+        note += " The NPV delta is arithmetic, not a causal attribution to an individual action."
+    return {
+        "status": status,
+        "checked_fields": list(a),
+        "missing_fields": missing,
+        "mismatched_fields": mismatched,
+        "a": a,
+        "b": b,
