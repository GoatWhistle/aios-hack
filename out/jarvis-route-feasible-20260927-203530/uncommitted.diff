+                "reason": f"validation/violations.json row {index} has invalid location or violation fields",
+            }
+        rows.append({
+            "kind": row["kind"],
+            "control_step": row.get("control_step"),
+            "well": well,
+            "region": row.get("region"),
+            "value": value,
+            "detail": detail or "",
+            "blocking": blocking,
+        })
+    return {
+        "recorded": True,
+        "rows": rows[:200],
+        "total": len(rows),
+        "truncated": len(rows) > 200,
+        "reason": None,
     }
 
 
