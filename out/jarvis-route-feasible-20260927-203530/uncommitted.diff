+        ("апрел", "apr"), ("ма", "may"), ("июн", "jun"),
+        ("июл", "jul"), ("август", "aug"), ("сентябр", "sep"),
+        ("октябр", "oct"), ("ноябр", "nov"), ("декабр", "dec"),
+    )
