# Server paths; fill the secret only on the target host. chmod 600 /etc/aios/jarvis.env
JARVIS_PROVIDER=openai-compatible
JARVIS_BASE_URL=https://nunaway.lol/v1
JARVIS_MODEL=gpt-5.5
JARVIS_API_KEY=
JARVIS_MAX_TOKENS=2400
JARVIS_MAX_CONCURRENT_REQUESTS=4
AIOS_PROJECT_ROOT=/opt/aios
AIOS_UI_DATA=/opt/aios/frontend/public/data
AIOS_JARVIS_RUNS=/opt/aios/out/jarvis-evidence-20260926/runs
AIOS_JARVIS_WEB_RUNS=/opt/aios/out/web-runs
AIOS_JARVIS_SESSIONS=/opt/aios/out/jarvis/sessions
AIOS_JARVIS_TTS_CACHE=/opt/aios/out/jarvis/tts
AIOS_JARVIS_DOCS=/opt/aios
AIOS_DATA_ROOT=/opt/aios-runtime/data
AIOS_DOCS_ROOT=/opt/aios-runtime/docs
