# Copy to .env.local (ignored by Git) and set your gateway key.
JARVIS_PROVIDER=openai-compatible
JARVIS_BASE_URL=https://nunaway.lol/v1
JARVIS_MODEL=gpt-5.5
JARVIS_API_KEY=
JARVIS_MAX_TOKENS=2400
JARVIS_MAX_CONCURRENT_REQUESTS=8
# Organizer normative docs (CHDD_PYTHON etc.) used by new search/verify calculations.
AIOS_DOCS_ROOT=../aios-hack/docs
# Host directory with the production surrogate and Model_Z runtime inputs for new calculations.
AIOS_DATA_ROOT=../aios-hack/aios/data
# Assistant knowledge-base docs paths (separate from AIOS_DOCS_ROOT above).
AIOS_JARVIS_DOCS='.;../aios-hack/docs;../aios-hack/aios'
# Optional public HTTPS root containing the same relative documentation paths.
AIOS_JARVIS_DOCS_BASE_URL=
# Optional, separate from the chat gateway: server transcription uses OpenRouter.
# OPENROUTER_API_KEY=
# Paths in this file are interpreted inside the container; /out is the mounted host ./out.
AIOS_JARVIS_RUNS=/out/jarvis-evidence-20260926/runs
AIOS_JARVIS_SESSION_TTL_DAYS=30
AIOS_JARVIS_BIND_ADDRESS=127.0.0.1
